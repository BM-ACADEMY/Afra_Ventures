# Copy to .env.local for local overrides. Every VITE_ value is embedded in the
# public JavaScript, so never put a secret here.

# Formspree / Web3Forms POST URL. Empty = the form opens email or WhatsApp instead.
VITE_FORM_ENDPOINT=

# true only for private preview builds (adds pilot, traction and brands pages).
VITE_INCLUDE_DRAFTS=false
