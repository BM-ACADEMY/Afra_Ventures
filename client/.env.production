# Used by `npm run build`. Every VITE_ value is embedded in the public
# JavaScript, so never put a secret here.

# Formspree / Web3Forms POST URL (Task 9.4). Empty = the form opens email or WhatsApp instead.
VITE_FORM_ENDPOINT=

# Must stay false for the live site. Draft pages are never published.
VITE_INCLUDE_DRAFTS=false
